{
  "name": "metagmo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/worker run dev",
    "lint": "npm --workspace apps/worker run lint",
    "test": "npm --workspace apps/worker run test",
    "typecheck": "npm --workspace apps/worker run typecheck"
  },
  "packageManager": "npm@10.8.2"
}
